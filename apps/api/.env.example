# Copy to apps/api/.env for running the api, the worker, or the db:* scripts on the HOST.
# Containers never read this file: compose passes them their own values, and the two contexts
# reach Postgres at different addresses, so the two connection strings are deliberately kept in
# separate places.

# Host tooling reaches Postgres on the port compose publishes.
DATABASE_URL=postgres://planetinha:planetinha@localhost:5432/planetinha

# Port the api listens on.
PORT=3000

# Interface the api binds to. 0.0.0.0 keeps the port reachable from outside a container.
HOST=0.0.0.0

# The upstream weather provider's forecast endpoint. Only the worker ever calls it.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# Pacing, all optional — the defaults are the ones the design was sized around. Lower SLICE_SIZE
# or raise SWEEP_WORKER_TICK_INTERVAL_MS if the Sweep's recorded Rate Limit hits say the pace is
# too fast.
# SLICE_SIZE=100
# SWEEP_WORKER_TICK_INTERVAL_MS=60000
# SWEEP_WORKER_SWEEP_INTERVAL_MS=43200000
