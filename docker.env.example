# Copy to docker.env at the repo root. Read only by the api and sweep-worker CONTAINERS via
# compose.yaml's env_file — everything either of them needs at runtime, in one place.
#
# Nothing here is a secret: the Postgres credentials are the same fixed planetinha/planetinha pair
# already visible in compose.yaml and apps/api/.env.example, so docker.env is safe to commit.
# It is still kept separate from apps/api/.env because DATABASE_URL genuinely differs between the
# two contexts — see "The two connection strings" in docs/running.md.

# The container's connection string, reaching Postgres by service name rather than by the
# published port apps/api/.env uses on the host.
DATABASE_URL=postgres://planetinha:planetinha@postgres:5432/planetinha

# The upstream weather provider's forecast endpoint. Only the Sweep Worker ever calls it.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# Port the api listens on inside its container.
PORT=3000
